<div class="work-experience">
  {% if site.data.work != blank %}
    {% assign work_size = site.data.work | size %}
    <div
      class="table-responsive"
      {% if include.limit and site.data.work.scrollable and work_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign work = site.data.work %}
        {% for item in work %}
          <tr>
            <td style="width: 70%">
              <strong>{{ item.company }}</strong><br>
              <span style="font-size: 0.9em; color: #666;">{{ item.position }}</span>
            </td>
            <td style="width: 30%; text-align: right;">
              {% if include.years_only %}
                {% assign period_parts = item.period | split: ' - ' %}
                {% assign first_year = period_parts | first | split: '.' | first %}
                {% assign last_year = period_parts | last | split: '.' | first %}
                {{ first_year -}}
                {%- if first_year != last_year %} – {{ last_year }}{% endif %}
              {% else %}
                {{ item.period }}
              {% endif %}
            </td>
          </tr>
          {% if include.detailed %}
            <tr>
              <td colspan="2">
                {% if item.details %}
                  {% if item.details.first %}
                    {% assign details_joined = item.details | join: ' ' %}
                    {{ details_joined | markdownify }}
                  {% else %}
                    {{ item.details | markdownify }}
                  {% endif %}
                {% endif %}
              </td>
            </tr>
          {% endif %}
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No work experience so far...</p>
  {% endif %}
</div>
